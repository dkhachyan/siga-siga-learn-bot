# Скопируй в .env и заполни. Файл .env в гит не попадает.

# --- окружение ---
ENV=local
LOG_LEVEL=INFO

# --- Telegram ---
# Токен выдаёт @BotFather при создании бота
BOT_TOKEN=

# polling — для локальной разработки, webhook — для сервера
BOT_MODE=polling

# Нужны только при BOT_MODE=webhook.
# WEBHOOK_BASE_URL — публичный https-адрес, на который Telegram шлёт апдейты.
# WEBHOOK_SECRET — произвольная строка, Telegram вернёт её в заголовке;
#   сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# --- база ---
# В docker compose хост — db, локально — localhost
DATABASE_URL=postgresql+asyncpg://siga:siga@localhost:5432/siga

# --- LLM ---
# offline — бот работает без модели: импорт слов есть, обогащение и эпизоды
# отвечают понятным отказом. deepseek — включить модель (нужен ключ).
LLM_PROVIDER=offline

# Ключ создаётся на platform.deepseek.com → API keys
DEEPSEEK_API_KEY=

# Меняются редко; заданы в коде, здесь — если нужно переопределить.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_MODEL_TEXT=deepseek-v4-flash
# LLM_MODEL_VISION=deepseek-v4-flash-vision-exp
# LLM_TIMEOUT_S=120
# LLM_MAX_RETRIES=3
