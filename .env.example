# Скопируй в .env и заполни. Файл .env в гит не попадает.

# --- окружение ---
ENV=local
LOG_LEVEL=INFO

# --- Telegram ---
# Токен выдаёт @BotFather при создании бота
BOT_TOKEN=

# polling — для локальной разработки, webhook — для сервера
BOT_MODE=polling

# Нужны только при BOT_MODE=webhook.
# WEBHOOK_BASE_URL — публичный https-адрес, на который Telegram шлёт апдейты.
# WEBHOOK_SECRET — произвольная строка, Telegram вернёт её в заголовке;
#   сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# --- база ---
# В docker compose хост — db, локально — localhost
DATABASE_URL=postgresql+asyncpg://siga:siga@localhost:5432/siga
